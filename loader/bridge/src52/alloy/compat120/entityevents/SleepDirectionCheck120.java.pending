package alloy.compat120.entityevents;

import com.llamalad7.mixinextras.sugar.Local;
import com.mojang.datafixers.util.Either;
import net.minecraft.core.BlockPos;
import net.minecraft.core.Direction;
import net.minecraft.server.level.ServerPlayer;
import net.minecraft.util.Unit;
import net.minecraft.world.entity.player.Player;
import org.spongepowered.asm.mixin.Mixin;
import org.spongepowered.asm.mixin.injection.At;
import org.spongepowered.asm.mixin.injection.Inject;
import org.spongepowered.asm.mixin.injection.callback.CallbackInfoReturnable;

/**
 * 1.21.1 (Forge 52): Fabric's ServerPlayerEntityMixin#onTrySleepDirectionCheck is stripped (Forge's startSleepInBed has its
 * sleep event first, so Fabric's capture point moved). EntitySleepEvents.MODIFY_SLEEPING_DIRECTION may answer null ("no
 * direction"); Fabric then refuses the bed with NOT_POSSIBLE_HERE. Without the check bedInRange got a null direction.
 * Same check, right after Forge's code has the direction (Fabric's own redirect on that getValue still runs).
 */
@Mixin(value = ServerPlayer.class, remap = false)
public abstract class SleepDirectionCheck120 {
    @Inject(method = "startSleepInBed", remap = false, cancellable = true,
            at = @At(value = "INVOKE", ordinal = 0, remap = false, target = "Lnet/minecraft/server/level/ServerPlayer;isSleeping()Z"))
    private void alloy$nullDirection(BlockPos pos, CallbackInfoReturnable<Either<Player.BedSleepingProblem, Unit>> cir,
                                     @Local Direction direction) {
        if (direction == null) cir.setReturnValue(Either.left(Player.BedSleepingProblem.NOT_POSSIBLE_HERE));
    }
}
