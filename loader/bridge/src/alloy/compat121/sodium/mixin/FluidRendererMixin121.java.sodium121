package alloy.compat121.sodium.mixin;

import alloy.compat121support.sodium.SodiumForge121;
import com.llamalad7.mixinextras.injector.wrapoperation.Operation;
import com.llamalad7.mixinextras.injector.wrapoperation.WrapOperation;
import net.caffeinemc.mods.sodium.fabric.render.FluidRendererImpl;
import net.fabricmc.fabric.api.client.render.fluid.v1.FluidRenderHandler;
import net.fabricmc.fabric.api.client.render.fluid.v1.FluidRenderHandlerRegistry;
import net.minecraft.world.level.material.Fluid;
import org.spongepowered.asm.mixin.Mixin;
import org.spongepowered.asm.mixin.injection.At;

/**
 * R4: Sodium's Fabric fluid renderer asks Fabric's FluidRenderHandlerRegistry for a fluid's handler and falls back to water
 * or lava. A Forge fluid has no Fabric handler, so it would mesh as water. Here a Forge fluid without one gets a handler
 * built from its IClientFluidTypeExtensions (still, flowing and overlay sprites, tint color).
 */
@Mixin(value = FluidRendererImpl.class, remap = false)
public abstract class FluidRendererMixin121 {
    @WrapOperation(method = "render", require = 1,
            at = @At(value = "INVOKE", ordinal = 0, target = "Lnet/fabricmc/fabric/api/client/render/fluid/v1/FluidRenderHandlerRegistry;get(Lnet/minecraft/world/level/material/Fluid;)Lnet/fabricmc/fabric/api/client/render/fluid/v1/FluidRenderHandler;"))
    private FluidRenderHandler alloy$forgeFluid(FluidRenderHandlerRegistry registry, Fluid fluid, Operation<FluidRenderHandler> original) {
        FluidRenderHandler h = original.call(registry, fluid);
        return h != null ? h : SodiumForge121.forgeFluid(fluid);
    }
}
