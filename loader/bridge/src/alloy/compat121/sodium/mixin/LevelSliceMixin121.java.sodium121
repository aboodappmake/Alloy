package alloy.compat121.sodium.mixin;

import alloy.compat121support.sodium.SnapshotModelDataManager121;
import net.caffeinemc.mods.sodium.client.world.LevelSlice;
import net.minecraft.client.multiplayer.ClientLevel;
import net.minecraftforge.client.model.data.ModelDataManager;
import org.spongepowered.asm.mixin.Final;
import org.spongepowered.asm.mixin.Mixin;
import org.spongepowered.asm.mixin.Shadow;
import org.spongepowered.asm.mixin.Unique;

/**
 * R11 on Sodium's LevelSlice (what Sodium hands models as the level while meshing):
 * <ul>
 * <li>Forge's IForgeBlockGetter.getModelDataManager() (the default returns null; mods read neighbour data through it),
 * answered from the slice's ModelData copy.</li>
 * <li>Forge's 4-float getShade, from the client level (the default rounds the normal to the nearest face), as NeoForge
 * Sodium's own LevelSliceMixin does.</li>
 * </ul>
 */
@Mixin(value = LevelSlice.class, remap = false)
public abstract class LevelSliceMixin121 {
    @Shadow @Final private ClientLevel level;
    @Unique private SnapshotModelDataManager121 alloy$manager;

    /** Overrides IForgeBlockGetter's default for LevelSlice. */
    public ModelDataManager getModelDataManager() {
        SnapshotModelDataManager121 m = this.alloy$manager;
        if (m == null) this.alloy$manager = m = new SnapshotModelDataManager121(this.level, (LevelSlice) (Object) this);
        return m;
    }

    /** Overrides IForgeBlockAndTintGetter's default for LevelSlice. */
    public float getShade(float normalX, float normalY, float normalZ, boolean shade) {
        return this.level.getShade(normalX, normalY, normalZ, shade);
    }
}
