package alloy.compat120.entity;

import java.util.Map;
import net.minecraft.core.registries.BuiltInRegistries;
import net.minecraft.world.entity.EntityType;
import net.minecraft.world.entity.LivingEntity;
import net.minecraft.world.entity.ai.attributes.Attribute;
import net.minecraft.world.entity.ai.attributes.AttributeSupplier;
import net.minecraft.world.entity.ai.attributes.Attributes;
import net.minecraft.world.entity.ai.attributes.DefaultAttributes;
import net.minecraftforge.common.ForgeHooks;
import net.minecraftforge.common.ForgeMod;
import org.spongepowered.asm.mixin.Final;
import org.spongepowered.asm.mixin.Mixin;
import org.spongepowered.asm.mixin.Shadow;
import org.spongepowered.asm.mixin.injection.At;
import org.spongepowered.asm.mixin.injection.Inject;
import org.spongepowered.asm.mixin.injection.callback.CallbackInfo;
import org.spongepowered.asm.mixin.injection.callback.CallbackInfoReturnable;

/**
 * 1.20.1: Fabric mods that build entity attributes in their main entrypoint (BetterEnd's Dragonfly, BetterNether's
 * Firefly: {@code Mob.createMobAttributes()} in a static initializer) run before Forge 47 fires its registry events, which
 * on 1.20.1 happen in the first resource reload. Forge's patched {@code LivingEntity.createLivingAttributes()} then calls
 * {@code ForgeMod.SWIM_SPEED.get()} and fails ("Registry Object not present: forge:swim_speed"), stopping the whole Fabric
 * main stage.
 *
 * <p>Fix: while Forge's attributes are not registered yet, createLivingAttributes returns the vanilla attribute set. When
 * Forge builds its attribute table ({@code ForgeHooks.modifyAttributes}, right after the registry events), every living
 * entity type whose default attributes lack Forge's ones gets them added, as the patched builder would have.
 */
public final class EarlyAttributesCompat120 {
    private EarlyAttributesCompat120() {}

    @Mixin(value = LivingEntity.class, remap = false)
    public abstract static class Builder {
        @Inject(method = "createLivingAttributes", at = @At("HEAD"), cancellable = true)
        private static void alloy$beforeForgeAttributes(CallbackInfoReturnable<AttributeSupplier.Builder> cir) {
            if (ForgeMod.SWIM_SPEED.isPresent()) return;
            // a counter in a system property: mixin classes cannot share static state through the (mixin) outer class
            System.setProperty("alloy.earlyAttributes", String.valueOf(Integer.getInteger("alloy.earlyAttributes", 0) + 1));
            cir.setReturnValue(AttributeSupplier.builder().add(Attributes.MAX_HEALTH).add(Attributes.KNOCKBACK_RESISTANCE)
                    .add(Attributes.MOVEMENT_SPEED).add(Attributes.ARMOR).add(Attributes.ARMOR_TOUGHNESS));
        }
    }

    /** Player.createAttributes adds forge:block_reach and forge:entity_reach; DefaultAttributes.<clinit> calls it, and Fabric's
     *  FabricDefaultAttributeRegistry touches DefaultAttributes from the same early entrypoints. */
    @Mixin(value = net.minecraft.world.entity.player.Player.class, remap = false)
    public abstract static class PlayerBuilder {
        @Inject(method = "createAttributes", at = @At("HEAD"), cancellable = true)
        private static void alloy$beforeForgeAttributes(CallbackInfoReturnable<AttributeSupplier.Builder> cir) {
            if (ForgeMod.BLOCK_REACH.isPresent()) return;
            System.setProperty("alloy.earlyAttributes", String.valueOf(Integer.getInteger("alloy.earlyAttributes", 0) + 1));
            cir.setReturnValue(LivingEntity.createLivingAttributes().add(Attributes.ATTACK_DAMAGE, 1.0D).add(Attributes.MOVEMENT_SPEED, 0.1F)
                    .add(Attributes.ATTACK_SPEED).add(Attributes.LUCK));
        }
    }

    @Mixin(value = ForgeHooks.class, remap = false)
    public abstract static class Fill {
        @Shadow @Final private static Map<EntityType<? extends LivingEntity>, AttributeSupplier> FORGE_ATTRIBUTES;

        @SuppressWarnings("unchecked")
        @Inject(method = "modifyAttributes", at = @At("TAIL"))
        private static void alloy$addForgeAttributes(CallbackInfo ci) {
            int early = Integer.getInteger("alloy.earlyAttributes", 0);
            if (early == 0) return;
            Attribute[] forge = {ForgeMod.SWIM_SPEED.get(), ForgeMod.NAMETAG_DISTANCE.get(), ForgeMod.ENTITY_GRAVITY.get(),
                    ForgeMod.STEP_HEIGHT_ADDITION.get()};
            int n = 0;
            for (EntityType<?> t : BuiltInRegistries.ENTITY_TYPE) {
                EntityType<? extends LivingEntity> lt = (EntityType<? extends LivingEntity>) t;
                if (!DefaultAttributes.hasSupplier(lt)) continue;
                AttributeSupplier s = DefaultAttributes.getSupplier(lt);
                boolean player = t == EntityType.PLAYER;
                if (!s.hasAttribute(Attributes.MAX_HEALTH)) continue;
                if (s.hasAttribute(forge[0]) && (!player || s.hasAttribute(ForgeMod.BLOCK_REACH.get()))) continue;
                AttributeSupplier.Builder b = new AttributeSupplier.Builder(s);
                for (Attribute a : forge) if (!s.hasAttribute(a)) b.add(a);
                if (player) {
                    if (!s.hasAttribute(ForgeMod.BLOCK_REACH.get())) b.add(ForgeMod.BLOCK_REACH.get());
                    if (!s.hasAttribute(ForgeMod.ENTITY_REACH.get())) b.add(ForgeMod.ENTITY_REACH.get());
                }
                FORGE_ATTRIBUTES.put(lt, b.build());
                n++;
            }
            org.apache.logging.log4j.LogManager.getLogger("Alloy").info(
                    "Alloy: {} attribute set(s) were built before Forge registered its attributes; added Forge's attributes to {} entity type(s)", early, n);
        }
    }
}
