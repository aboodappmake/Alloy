package alloy.compat120.block;

import net.minecraft.core.BlockPos;
import net.minecraft.core.Direction;
import net.minecraft.world.level.BlockAndTintGetter;
import net.minecraft.world.level.block.Block;
import net.minecraft.world.level.block.state.BlockState;
import org.spongepowered.asm.mixin.Mixin;

/**
 * 1.20.1 (Forge 47, Fabric API 0.92.x): getAppearance is a default method of both Forge's IForgeBlock / IForgeBlockState
 * and Fabric's FabricBlock / FabricBlockState, with the same name and descriptor. Block and BlockState implement both, so
 * every call that does not land on a mod override fails with "IncompatibleClassChangeError: Conflicting default methods"
 * (seen with Presence Footsteps). These concrete methods resolve it. Both defaults do the same thing: the block's answer for
 * a state, and the state itself for a block that does not override it. Mod blocks (Forge or Fabric) that override
 * getAppearance still override these.
 */
public final class BlockAppearanceCompat120 {
    private BlockAppearanceCompat120() {}

    @Mixin(value = Block.class, remap = false)
    public abstract static class OnBlock {
        public BlockState getAppearance(BlockState state, BlockAndTintGetter level, BlockPos pos, Direction side,
                                        BlockState queryState, BlockPos queryPos) {
            return state;
        }
    }

    @Mixin(value = BlockState.class, remap = false)
    public abstract static class OnState {
        public BlockState getAppearance(BlockAndTintGetter level, BlockPos pos, Direction side,
                                        BlockState queryState, BlockPos queryPos) {
            BlockState self = (BlockState) (Object) this;
            return ((net.minecraftforge.common.extensions.IForgeBlock) self.getBlock()).getAppearance(self, level, pos, side, queryState, queryPos);
        }
    }
}
