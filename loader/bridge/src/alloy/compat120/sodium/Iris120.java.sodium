package alloy.compat120support.sodium;

import net.minecraft.client.renderer.RenderType;
import net.minecraft.world.level.block.Block;
import net.minecraft.world.level.block.state.BlockState;

import java.lang.invoke.MethodHandle;
import java.lang.invoke.MethodHandles;
import java.lang.invoke.MethodType;
import java.util.Map;

/**
 * Iris 1.7.x shader pack layer overrides, by reflection so the bridge compiles without Iris on the class path.
 * Iris applies them in ItemBlockRenderTypes.getChunkRenderType (MixinItemBlockRenderTypes, HEAD), which SodiumForge120
 * then uses as is.
 */
final class Iris120 {
    private static final Object SETTINGS;
    private static final MethodHandle BLOCK_TYPE_IDS;
    static {
        Object s = null;
        MethodHandle h = null;
        try {
            Class<?> c = IrisNames120.cls("net.irisshaders.iris.shaderpack.materialmap.WorldRenderingSettings");
            s = c.getField("INSTANCE").get(null);
            h = MethodHandles.publicLookup().findVirtual(c, "getBlockTypeIds", MethodType.methodType(Map.class)).bindTo(s);
        } catch (ReflectiveOperationException | RuntimeException | LinkageError e) {
            SodiumForge120.LOG.warn("Iris WorldRenderingSettings.getBlockTypeIds not found; shader pack layer overrides are not checked: {}", e.toString());
        }
        SETTINGS = s;
        BLOCK_TYPE_IDS = h;
    }

    private Iris120() { }

    /** True when the active shader pack sets a layer for this block (block.properties "layer.*"). */
    @SuppressWarnings("unchecked")
    static boolean hasLayerOverride(BlockState state) {
        if (BLOCK_TYPE_IDS == null) return false;
        try {
            Map<Block, RenderType> ids = (Map<Block, RenderType>) BLOCK_TYPE_IDS.invoke();
            return ids != null && ids.get(state.getBlock()) != null;
        } catch (Throwable t) {
            return false;
        }
    }
}
