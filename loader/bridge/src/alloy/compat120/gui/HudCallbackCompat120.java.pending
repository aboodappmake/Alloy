package alloy.compat120.gui;

import net.fabricmc.fabric.api.client.rendering.v1.HudRenderCallback;
import net.minecraft.client.Minecraft;
import net.minecraftforge.client.event.RenderGuiEvent;
import net.minecraftforge.client.gui.overlay.ForgeGui;
import net.minecraftforge.common.MinecraftForge;
import net.minecraftforge.eventbus.api.EventPriority;
import org.spongepowered.asm.mixin.Mixin;
import org.spongepowered.asm.mixin.injection.At;
import org.spongepowered.asm.mixin.injection.Inject;
import org.spongepowered.asm.mixin.injection.callback.CallbackInfo;

/**
 * 1.20.1 (Forge 47, Fabric API 0.92.x): Fabric's HudRenderCallback fires again.
 *
 * <p>fabric-rendering-v1 fires HudRenderCallback at the end of Gui.render. Forge's client uses ForgeGui, which overrides
 * render and never calls super, so the hook never runs and every Fabric mod that draws its HUD that way draws nothing
 * (MiniHUD info lines, Origins' resource bars). No error is logged.
 *
 * <p>Fix: when Forge builds its ForgeGui, a listener for RenderGuiEvent.Post (posted after all of Forge's overlays, the same
 * place Fabric's hook has on vanilla) calls HudRenderCallback with the event's GuiGraphics and partial tick. Fabric's own
 * InGameHudMixin#render is stripped (compat_replaces.1.20.1.txt), so a mod that calls super.render cannot fire it twice.
 */
@Mixin(value = ForgeGui.class, remap = false)
public abstract class HudCallbackCompat120 {
    private static boolean alloy$registered;

    @Inject(method = "<init>", at = @At("RETURN"))
    private void alloy$hookHud(Minecraft mc, CallbackInfo ci) {
        synchronized (ForgeGui.class) {   // (a mixin class itself can never be referenced at run time)
            if (alloy$registered) return;
            alloy$registered = true;
        }
        MinecraftForge.EVENT_BUS.addListener(EventPriority.NORMAL, false, RenderGuiEvent.Post.class,
                e -> HudRenderCallback.EVENT.invoker().onHudRender(e.getGuiGraphics(), e.getPartialTick()));
    }
}
