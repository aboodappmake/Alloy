package alloy.compat120.net;

import java.lang.reflect.Field;
import java.util.ArrayList;
import java.util.List;
import java.util.Map;
import com.google.common.collect.BiMap;
import net.fabricmc.api.EnvType;
import net.fabricmc.loader.api.FabricLoader;
import net.minecraft.resources.ResourceKey;
import net.minecraft.resources.ResourceLocation;
import net.minecraftforge.registries.ForgeRegistry;
import org.slf4j.Logger;
import org.slf4j.LoggerFactory;
import org.spongepowered.asm.mixin.Mixin;
import org.spongepowered.asm.mixin.Unique;
import org.spongepowered.asm.mixin.injection.At;
import org.spongepowered.asm.mixin.injection.Inject;
import org.spongepowered.asm.mixin.injection.callback.CallbackInfo;

/**
 * 1.20.1 client (Forge 47): keep client-only particle types of Fabric mods when Forge applies the server's registry snapshot.
 *
 * <p>ForgeRegistry.sync clears the client registry and refills it from the server's snapshot. Some Fabric mods register
 * particle types only on the client; the server does not know them, so they vanish and the mod crashes later (null key) or
 * its particles stop. Same fix as Connector 1.20.1 (ClientForgeRegistryMixin + RegistryUtil.retainFabricClientEntries):
 * before the first clear, entries of minecraft:particle_type that belong to a Fabric mod and are missing from the snapshot are
 * put into the snapshot's name map, so sync gives them a free id. Only particle types, only on the client.
 */
@Mixin(value = ForgeRegistry.class, remap = false)
public abstract class ForgeRegistrySyncCompat120<V> {
    @Unique private static final Logger ALLOY$LOG = LoggerFactory.getLogger("Alloy");
    @Unique private static Field alloy$names;

    @Inject(method = "sync(Lnet/minecraft/resources/ResourceLocation;Lnet/minecraftforge/registries/ForgeRegistry;)V",
            at = @At(value = "INVOKE", target = "Lcom/google/common/collect/BiMap;clear()V", ordinal = 0), require = 0)
    private void alloy$keepClientEntries(ResourceLocation name, ForgeRegistry<V> from, CallbackInfo ci) {
        if (!"minecraft:particle_type".equals(String.valueOf(name))) return;
        try {
            if (FabricLoader.getInstance().getEnvironmentType() != EnvType.CLIENT) return;
            List<Map.Entry<ResourceLocation, V>> keep = new ArrayList<>();
            for (Map.Entry<ResourceKey<V>, V> e : ((ForgeRegistry<V>) (Object) this).getEntries()) {
                ResourceLocation id = e.getKey().location();
                if (!from.containsKey(id) && alloy$fabricMod(id.getNamespace())) keep.add(Map.entry(id, e.getValue()));
            }
            if (keep.isEmpty()) return;
            if (alloy$names == null) {
                Field f = ForgeRegistry.class.getDeclaredField("names");
                f.setAccessible(true);
                alloy$names = f;
            }
            @SuppressWarnings("unchecked")
            BiMap<ResourceLocation, V> names = (BiMap<ResourceLocation, V>) alloy$names.get(from);
            for (Map.Entry<ResourceLocation, V> e : keep) names.put(e.getKey(), e.getValue());
            ALLOY$LOG.info("Alloy net compat: kept {} client-only Fabric entries in {} through Forge's registry sync: {}",
                    keep.size(), name, keep.stream().map(Map.Entry::getKey).toList());
        } catch (Throwable t) {
            ALLOY$LOG.warn("Alloy net compat: could not keep client-only Fabric entries in {}: {}", name, t.toString());
        }
    }

    /** A namespace that is a Fabric mod's id and not a Forge mod's (and not minecraft). */
    @Unique
    private static boolean alloy$fabricMod(String ns) {
        if (ns.equals("minecraft") || ns.equals("forge") || !FabricLoader.getInstance().isModLoaded(ns)) return false;
        try {
            Object list = Class.forName("net.minecraftforge.fml.ModList").getMethod("get").invoke(null);
            return !(Boolean) list.getClass().getMethod("isLoaded", String.class).invoke(list, ns);
        } catch (Throwable t) {
            return true;
        }
    }
}
